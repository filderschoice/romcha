root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = ktlint_official
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{md,yaml,yml,toml}]
indent_size = 2

# テスト名は日本語で振る舞いを書く（日本人エンジニアが読みやすいように）ため、関数命名規則の対象外にする
[**/src/test/**/*.kt]
ktlint_standard_function-naming = disabled
