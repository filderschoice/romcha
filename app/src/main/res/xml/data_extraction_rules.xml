<?xml version="1.0" encoding="utf-8"?>
<!-- 設定・閲覧履歴は端末内にのみ保持する（N-06）ため、クラウドバックアップ・端末間移行の対象から外す -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
